    PAGINA RAZOR
*@
@{
}
@model List<Appcrud.Models.Empleado>;    //llamamos la lista desde solucion>modelos

<div class="row">   <!--BOOTSTRAP-->
    <div class="col-sm-8 offset-sm-2">
        <h2>lista de empleados</h2>
        <a asp-controller="Empleado" asp-action="Nuevo" class="btn btn-success mb-3">Nuevo</a>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>id</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Fecha Contrato</th>
                    <th>Activo</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model)
                {
                    <tr>
                        <td>@item.IdEmpleado</td>
                        <td>@item.NombreCompleto</td>
                        <td>@item.Correo</td>
                        <td>@item.FechaContrato.ToString("dd/MM/yyyy")</td>
                        <td>@(item.Activo ? "SI": "NO")</td>
                        <td>
                            @* REDIRECCIONA AL METODO EDITAR *@
                            <a 
                                asp-controller="Empleado" 
                                asp-action="Editar"
                                asp-route-id="@item.IdEmpleado"
                                class="btn btn-primary">Editar</a>


                            <a asp-controller="Empleado"
                               asp-action="Eliminar"
                               asp-route-id="@item.IdEmpleado"
                               onclick="return confirmar()"
                               class="btn btn-danger">Eliminar</a>

                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>


@section Scripts{
    <script>
        function confirmar(){
            return confirm("esta seguro de borrar al empleado???")
        }
    </script>
}